# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=https://your-portfolio.vercel.app,https://www.yourcustomdomain.com

# ─── AI (OpenRouter ) ──────────────────────────────────────────────────────────
# All AI calls (Pai chat + haiku generation) go through OpenRouter's fallback chain.
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── GitHub (live context for Pai + haiku RAG ) ────────────────────────────────
# Create a fine-grained PAT at https://github.com/settings/tokens
# Required scopes: Contents (read ), Metadata (read) — public repos only is fine
GITHUB_PAT=your_github_pat_here
GITHUB_USERNAME=your_github_username_here

# ─── Haiku cache ──────────────────────────────────────────────────────────────
# How long (in seconds) to cache generated haikus before regenerating
# Default: 86400 = 24 hours (60sec × 60min × 24hrs)
HAIKU_CACHE_TTL=86400

# ─── Digital Twin voice (ElevenLabs) ───────────────────────────────────────────
# Powers the "Talk to PK" call's cloned voice. Both keys stay server-side —
# the client never sees them.
# 1. Sign up at https://elevenlabs.io
# 2. Voices → Add Voice → Instant Voice Clone. Use ~1-2 min of clean,
#    single-speaker audio — quiet room, no background music/reverb. Quality
#    beats length. (Instant clone needs a paid tier, not the free plan.)
# 3. Copy the API key from Profile → API Keys, and the voice_id from the
#    voice you just created.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# ─── Digital Twin face (Simli) ──────────────────────────────────────────────────
# Powers the real-time talking-head avatar layered over the call. Optional —
# without these set, the call still works as voice-only (static portrait +
# voice), it just won't have a live animated face.
# 1. Sign up at https://simli.ai ($10 signup credit + ~50 free min/month,
#    pay-as-you-go after that at roughly $0.05/min)
# 2. Create an avatar from ONE reference photo: high resolution, sharp focus
#    (especially the eyes), simple/clean background. Processing takes a
#    couple of hours, not instant — plan around that, don't expect to
#    iterate on several photos in one sitting.
# 3. Copy the API key and the Face ID it gives you.
SIMLI_API_KEY=your_simli_api_key_here
SIMLI_FACE_ID=your_simli_face_id_here

# 10-minute-per-call hard cap, enforced in-process on every /api/chat, /api/tts,
# and /api/simli/session request for a given call. Independent of the optional
# Supabase gate below — this one always applies.
CALL_SESSION_CAP_SECONDS=600

# ─── Digital Twin call-rate gate (optional, Supabase) ──────────────────────────
# Daily-per-visitor / daily-per-IP / monthly-minutes limits on top of the
# per-call cap above. Skip this section entirely and the call feature still
# works — it just has no cost ceiling beyond the 10-min-per-call cap, so only
# skip it if you're comfortable with that.
# 1. Create a free project at https://supabase.com
# 2. SQL Editor → run backend/scripts/supabase_call_sessions.sql
# 3. Project Settings → API → copy the URL and the service_role key (NOT the
#    anon/public key — the service role key bypasses row-level security,
#    which is required here and is exactly why it must never reach the client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Random string mixed into the IP-hashing salt so hashed IPs in the
# call_sessions table can't be reversed/rainbow-tabled. Any long random value.
IP_HASH_SALT=change_this_to_a_random_string

# Limits enforced by the gate above (defaults shown)
DAILY_CALLS_PER_VISITOR=2
DAILY_CALLS_PER_IP=6
MONTHLY_CALL_MINUTES=200

# ─── Contact form (Gmail SMTP) ────────────────────────────────────────────────
# The Gmail address that SENDS the contact form emails
SMTP_USER=your_gmail_address@gmail.com

# App Password — NOT your regular Gmail password.
# How to get it:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required )
#   3. Search "App passwords" in the search bar
#   4. Create a new app password → App name: "Portfolio Backend" → Generate
#   5. Copy the 16-character password shown (spaces don't matter, ignore them)
SMTP_PASS=xxxx xxxx xxxx xxxx

# The Gmail address that RECEIVES the contact form submissions (can be same as SMTP_USER)
RECIPIENT_EMAIL=your_email_here@gmail.com

# ─── SMTP server (defaults work for Gmail, no need to change) ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
